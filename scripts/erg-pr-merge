#!/usr/bin/env bash
# erg-pr-merge — close ticket and squash-merge a PR atomically
#
# Usage: erg-pr-merge [PR_NUMBER]
#
# Must be run from the PR's head branch. If PR_NUMBER is omitted, the current
# branch is used to find the associated PR.
#
# Happy path:
#   0. Verify: on PR head branch, CI green, no conflicts
#   1. Find ticket ID from "**Ticket:** tickets/NNNN-..." line in PR body
#   2. erg close NNNN done + git add + commit + push  (inside the squash)
#   3. gh pr merge --squash --delete-branch
#   4. git checkout main && git pull --rebase origin main

set -euo pipefail

die() { echo "erg-pr-merge: $*" >&2; exit 1; }

# ── Step 0: resolve PR ────────────────────────────────────────────────────────

if [[ $# -gt 0 ]]; then
    PR="$1"
else
    PR=$(gh pr view --json number --jq '.number' 2>/dev/null) \
        || die "not on a PR branch — pass PR number as argument"
fi

echo "PR #$PR"

# Fetch PR metadata
PR_JSON=$(gh pr view "$PR" --json number,headRefName,mergeable,statusCheckRollup,body)

PR_BRANCH=$(echo "$PR_JSON" | jq -r '.headRefName')
CURRENT_BRANCH=$(git branch --show-current)

if [[ "$CURRENT_BRANCH" != "$PR_BRANCH" ]]; then
    die "must run from PR branch '${PR_BRANCH}'; run: git checkout ${PR_BRANCH}"
fi

# Check for conflicts
MERGEABLE=$(echo "$PR_JSON" | jq -r '.mergeable')
if [[ "$MERGEABLE" == "CONFLICTING" ]]; then
    die "PR has merge conflicts — resolve before merging"
fi

# Check CI status (warn but do not block if no checks exist)
FAILING=$(echo "$PR_JSON" | jq -r '
    [.statusCheckRollup[]? | select(.conclusion == "FAILURE" or .conclusion == "TIMED_OUT")]
    | length')
if [[ "$FAILING" -gt 0 ]]; then
    die "CI has ${FAILING} failing check(s) — fix before merging"
fi

# ── Step 1: find ticket ID ────────────────────────────────────────────────────

BODY=$(echo "$PR_JSON" | jq -r '.body // ""')

# Match "**Ticket:** tickets/NNNN-..." and extract NNNN
TICKET_FILE=$(echo "$BODY" | grep -oP '(?<=\*\*Ticket:\*\* )tickets/[^\s]+' | head -1)
TICKET_ID=$(echo "$TICKET_FILE" | grep -oP '^\d+' || true)

# ── Step 2: close ticket (only if erg project and ticket found) ───────────────

if [[ -n "$TICKET_ID" ]] && [[ -d tickets ]] && command -v erg &>/dev/null; then
    echo "Closing ticket ${TICKET_ID}..."
    erg close "$TICKET_ID" done

    # Stage only the specific ticket file(s) touched by close
    TICKET_GLOB="tickets/${TICKET_ID}-"*.erg
    # shellcheck disable=SC2086
    git add $TICKET_GLOB tickets/closed/ 2>/dev/null || true

    git commit -m "ticket(${TICKET_ID}): close — done"
    git push
elif [[ -n "$TICKET_ID" ]]; then
    echo "Note: ticket ${TICKET_ID} found but no erg available — skipping close"
else
    echo "Note: no **Ticket:** line in PR body — skipping close"
fi

# ── Step 3: squash merge ──────────────────────────────────────────────────────

echo "Merging PR #${PR}..."
gh pr merge "$PR" --squash --delete-branch

# ── Step 4: return to main ────────────────────────────────────────────────────

MAIN_BRANCH=$(git remote show origin 2>/dev/null | awk '/HEAD branch/ {print $NF}')
MAIN_BRANCH="${MAIN_BRANCH:-main}"

git checkout "$MAIN_BRANCH"
git pull --rebase origin "$MAIN_BRANCH"

echo "Done."
