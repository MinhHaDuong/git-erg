#!/bin/sh
# erg-github -- the GitHub forge layer for git-erg.
#
# erg core (the binary) is offline and forge-blind. This committed helper is
# the only forge-aware piece: it travels with the clone and is learned via
# README/AGENTS.md, not dispatched by the binary (the hyphen is the link
# convention, like git's git-foo helpers). It depends on `gh` and `git`.
#
# Verbs:
#   install   Write .github/workflows/erg-verify.yml (a required pre-merge
#             check that runs `erg-github verify`). Idempotent.
#   verify    Discover the ticket a PR references and fail if it is still open
#             ("Please close ticket NNNN in this PR"). The autoclose mechanism
#             that does NOT depend on the /merge harness skill: enforcement at
#             CI time, the close embedded in the PR by the author (erg core).
#
# Degradation is environment-keyed (design council, ticket 0209): locally
# (no CI) a could-not-verify is non-blocking (exit 0) so non-forge adopters
# are never wedged; in CI (GITHUB_ACTIONS set) a could-not-verify FAILS CLOSED
# (exit 1) -- a required check that is green but could not actually run
# enforces nothing.
set -eu

PROG="erg-github"

# Repo root, CWD-independent (the hook / CI / an interactive subdir all differ).
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "$PROG: not in a git work tree" >&2
	exit 0
}

in_ci() { [ -n "${GITHUB_ACTIONS:-}" ]; }

# could_not_verify MSG: fail closed in CI, lenient locally.
could_not_verify() {
	if in_ci; then
		echo "$PROG verify: $1 -- failing closed in CI (a required check that cannot run enforces nothing)" >&2
		exit 1
	fi
	echo "$PROG verify: $1 -- skipping (local, non-blocking)" >&2
	exit 0
}

# ticket_is_closed ID: true if ticket ID is archived (in closed/) or carries a
# non-empty Closed: header in the top-level store. Reads the checked-out tree.
ticket_is_closed() {
	id=$1
	for f in "$root"/tickets/closed/"$id"-*.erg; do
		[ -e "$f" ] && return 0
	done
	for f in "$root"/tickets/"$id"-*.erg; do
		[ -e "$f" ] || continue
		if grep -qE '^Closed:[[:space:]]*[^[:space:]]' "$f"; then
			return 0
		fi
	done
	return 1
}

cmd_verify() {
	pr_num=${1:-}

	command -v gh >/dev/null 2>&1 || could_not_verify "gh not found"

	if [ -n "$pr_num" ]; then
		body=$(gh pr view "$pr_num" --json body --jq .body 2>/dev/null) ||
			could_not_verify "cannot read PR $pr_num (gh unauthenticated?)"
	else
		body=$(gh pr view --json body --jq .body 2>/dev/null) ||
			could_not_verify "no PR for the current branch (gh unauthenticated?)"
	fi

	# Extract every Ticket: reference, matching the same id-set as
	# skills/merge/erg-pr-merge: line-anchored, case-insensitive, 0-2 asterisks,
	# optional colons. Portable (grep -iE + BRE sed; never GNU-only grep -oP).
	ids=$(printf '%s\n' "$body" |
		grep -iE '^[*]{0,2}ticket:?[*]{0,2}:? *tickets/[0-9]{4}' 2>/dev/null |
		sed 's/.*tickets\/\([0-9][0-9][0-9][0-9]\).*/\1/' || true)

	if [ -z "$ids" ]; then
		# Escape hatch: an unlinked / emergency merge. Loud and distinct from a
		# real pass so it is auditable -- the PR author controls the body, so
		# this path is advisory-with-audit, not unbypassable.
		echo "$PROG verify: PASS -- no ticket referenced (escape hatch invoked)" >&2
		if in_ci; then
			echo "::warning::erg-github verify: PR references no ticket (escape hatch)"
		fi
		exit 0
	fi

	n=$(printf '%s\n' "$ids" | grep -c . || true)
	if [ "$n" -gt 1 ]; then
		echo "$PROG verify: PR references multiple tickets ($(printf '%s' "$ids" | tr '\n' ' ')); one PR closes one ticket." >&2
		exit 1
	fi

	id=$(printf '%s\n' "$ids" | head -1)
	if ticket_is_closed "$id"; then
		echo "$PROG verify: PASS -- ticket $id is closed in this PR" >&2
		exit 0
	fi

	echo "$PROG verify: FAIL -- please close ticket $id in this PR (add a Closed: header via 'erg close $id REASON')." >&2
	exit 1
}

cmd_install() {
	wf_dir="$root/.github/workflows"
	wf="$wf_dir/erg-verify.yml"
	mkdir -p "$wf_dir"
	if [ -e "$wf" ]; then
		echo "$PROG install: $wf already exists -- leaving it untouched." >&2
		echo "  Delete it first if you want erg-github to regenerate the pinned workflow." >&2
		return 0
	fi
	cat > "$wf" <<'YAML'
# Generated by: erg-github install
# Required pre-merge check: fails a PR that references a ticket which is still
# open. The close is committed in the PR by the author (erg core); this only
# discovers and enforces. No paths filter -- a required check must run on
# every PR. Reads the PR HEAD tree so the closed-state reflects the author's
# in-PR close. Merge queue (merge_group) is not handled; verify posts on
# pull_request only.
name: erg-verify

on:
  pull_request:

permissions:
  contents: read
  pull-requests: read

jobs:
  erg-verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
      - name: erg-github verify
        env:
          GH_TOKEN: ${{ github.token }}
        run: ./tickets/erg-github verify ${{ github.event.pull_request.number }}
YAML
	echo "$PROG install: wrote $wf" >&2
	echo "  Add 'erg-verify' as a required status check in branch protection to enforce it." >&2
}

verb=${1:-}
case "$verb" in
install)
	shift
	cmd_install "$@"
	;;
verify)
	shift
	cmd_verify "$@"
	;;
*)
	echo "usage: $PROG <install|verify>" >&2
	echo "  install   write .github/workflows/erg-verify.yml (required pre-merge check)" >&2
	echo "  verify    fail if the PR references a still-open ticket" >&2
	exit 2
	;;
esac
